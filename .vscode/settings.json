{
  "files.exclude": {
    // "**/.git": true,
    // "**/node_modules": true,
    // ".private/": true,
    // ".temp/": true,
    // "dist/": true,
    // ".gitignore": true,
    // "package-lock.json": true,
    // "package.json": true,
    // "tsconfig*.json": true,
    // "eslint.rules.js": true,
    // "eslint.config.js": true,
    // "vitest.config.ts": true,
    // "LICENSE.md": true
  },
  "search.exclude": {
    "**/.git": true,
    "**/node_modules": true,
    ".private/": true,
    ".temp/": true,
    "dist/": true,
    ".gitignore": true,
    "package-lock.json": true,
    "package.json": true,
    "tsconfig*.json": true,
    "eslint.rules.js": true,
    "eslint.config.js": true,
    "vitest.config.ts": true,
    "LICENSE.md": true
  },
  "googleSearchContextMenu.items": {
    "MDNWeb": {
      "enabled": true
    },
    "NodeJS": {
      "enabled": true
    }
  },
  // Запускает eslint с системной версией NodeJS
  "eslint.runtime": "node",
  "eslint.useESLintClass": true,
  "eslint.useFlatConfig": true,
  "eslint.codeActionsOnSave.mode": "problems",
  // "eslint.codeActionsOnSave.mode": "all",
  // Отключаем действия для правил удаляющих код при форматировании. Если выше включен mode:"problems" - эта настройка игнорируется.
  // !rule - off
  // *     - on
  "eslint.codeActionsOnSave.rules": [
    "!no-unused-vars",
    "!@typescript-eslint/no-unused-vars",
    "*"
  ],
  // https://code.visualstudio.com/docs/editing/refactoring#_code-actions-on-save
  "editor.codeActionsOnSave": {
    // Смотри варианты настроек здесь https://github.com/microsoft/vscode-eslint
    "source.fixAll.eslint": "explicit"
    // Обе опции не могут сортировать импорт начиная с типов
    // "source.organizeImports": "explicit",
    // "source.sortImports": "explicit"
  },
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "vitest.shellType": "terminal",
  // Это нужно для поддержки плагина: TypeScript 7 > Experimental: Use Tsgo https://marketplace.visualstudio.com/items?itemName=TypeScriptTeam.native-preview
  // "js/ts.experimental.useTsgo": true,
}
